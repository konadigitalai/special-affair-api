ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://app_role:replace-me@server.postgres.database.azure.com:5432/specialaffair?sslmode=require
DATABASE_MIGRATION_URL=postgresql+asyncpg://migration_role:replace-me@server.postgres.database.azure.com:5432/specialaffair?sslmode=require
AUTH0_DOMAIN=tenant.example.auth0.com
AUTH0_AUDIENCE=https://api.example.com
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
SANDBOX_PAYMENT_SECRET=local-sandbox-secret
TOKEN_SIGNING_SECRET=change-this-local-token-secret
LOG_LEVEL=INFO

# Development providers. Live provider adapters are intentionally deferred.
PAYMENT_PROVIDER=sandbox
SANDBOX_BROWSER_PAYMENTS_ENABLED=false
PAYMENT_RETURN_URL=http://localhost:3000/payment/upi-return
RESERVATION_TTL_MINUTES=15
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=120

# Provisional business policies: confirm before production.
REFUND_APPROVAL_THRESHOLD_MINOR=100000
RETURN_WINDOW_DAYS=30
TAX_RATE_PERCENT=18
SHIPPING_FEE_MINOR=0

# Azure managed identity is preferred; no Azure client secret is needed locally.
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_KEY_VAULT_URL=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=product-media

# Optional embeddings endpoint accepting {model,input} and returning data[0].embedding.
# Provision pgvector and index approved products before enabling.
SEMANTIC_SEARCH_ENABLED=false
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
