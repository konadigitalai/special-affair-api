ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://app_role:replace-me@server.postgres.database.azure.com:5432/specialaffair?sslmode=require
DATABASE_MIGRATION_URL=postgresql+asyncpg://migration_role:replace-me@server.postgres.database.azure.com:5432/specialaffair?sslmode=require
AUTH0_DOMAIN=tenant.example.auth0.com
AUTH0_AUDIENCE=https://api.example.com
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
SANDBOX_PAYMENT_SECRET=local-sandbox-secret
TOKEN_SIGNING_SECRET=change-this-local-token-secret
LOG_LEVEL=INFO
